---
import { Icon } from "astro-icon/components";

import { PROJECTS } from "../../../../data";
import SectionTitle from "../../../SectionTitle.astro";
import ProjectCard from "./ProjectCard/ProjectCard.astro";
import Action from "../../../Action.astro";
import Section from "../../../Section.astro";
import { getLangFromUrl, useTranslation } from "../../../../config";

const { url } = Astro;
const [language] = getLangFromUrl(url);
const { t } = useTranslation({ language });
---

<Section className="flex flex-col gap-8 pt-24 md:pt-32" id="projects">
  <SectionTitle index="03" title="home.projects.title" />

  <div class="grid w-full grid-cols-1 gap-6 py-4 md:grid-cols-2">
    {PROJECTS.map((project) => <ProjectCard project={project} />)}
  </div>

  <div class="flex w-full">
    <Action className="grow-0">
      <a
        class="inline-flex items-center gap-4 px-6 py-3 text-base"
        href="https://github.com/leo-alvarenga?tab=repositories"
        target="_blank"
      >
        <i class="devicon-github-original text-lg"></i>
        <span>{t("commons.gh.seeMore")}</span>
        <Icon name="fa6-solid:arrow-up-right-from-square" />
      </a>
    </Action>
  </div>
</Section>
