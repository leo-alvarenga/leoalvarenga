---
import { Icon } from "astro-icon/components";

import { PROJECTS } from "../../../../data";
import SectionTitle from "../../../SectionTitle.astro";
import ProjectCard from "./ProjectCard/ProjectCard.astro";
import Button from "../../../Button.astro";
import Section from "../../../Section.astro";
import { getLangFromUrl, useTranslation } from "../../../../config";


const { url } = Astro;
const [language] = getLangFromUrl(url);
const { t } = useTranslation({ language });
---

<Section className="flex flex-col gap-4 pt-12" id="projects">
  <SectionTitle title="home.projects.title" />

  <div
    class={`
      flex flex-col gap-8
      items-center px-0 md:px-8 py-4 w-full
    `}
  >
    {PROJECTS.map((project) => <ProjectCard project={project} />)}

    
  <Button className={`
      px-4 py-2 group grow-0 rounded-lg
      duration:500 transition-all
      hover:bg-accent1 hover:text-bg3
    `}
  >
    <a class="flex items-center gap-4" href="https://github.com/leo-alvarenga?tab=repositories" target="_blank">
      <span>
        <i class="devicon-github-original text-lg"></i>
      </span>

      <span class="group-hover:underline">{t("commons.gh.seeMore")}</span>
      <Icon name="fa6-solid:arrow-up-right-from-square" />
    </a>
  </Button>
  </div>
</Section>
