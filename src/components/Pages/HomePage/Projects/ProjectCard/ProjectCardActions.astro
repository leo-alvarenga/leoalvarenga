---
import { Icon } from "astro-icon/components";
import Action from "../../../../Action.astro";

import { getAltUrl, getLangFromUrl, useTranslation } from "../../../../../config";

interface Props {
  preview?: string;
  repo?: string;
}

const { url } = Astro;
const [language] = getLangFromUrl(url);
const { t } = useTranslation({ language });

const { preview, repo } = Astro.props;

const getSafeHref = (href = "/disabled") => {
  if (!href.startsWith("/")) return href;
  return getAltUrl(url, language, href) || "/";
};
---

<div class="flex gap-4 items-center">
  <Action className={`grow-0 ${!repo?.length ? "pointer-events-none opacity-40" : ""}`}>
    <a
      class="inline-flex items-center gap-2 px-4 py-2 text-sm"
      href={getSafeHref(repo)}
      target="_blank"
    >
      <span>{t("commons.repository")}</span>
      <i class="devicon-github-original text-lg"></i>
    </a>
  </Action>

  <Action className={`grow-0 ${!preview?.length ? "pointer-events-none opacity-40" : ""}`}>
    <a
      class="inline-flex items-center gap-2 px-4 py-2 text-sm"
      href={getSafeHref(preview)}
      target="_blank"
    >
      <span>{t("commons.preview")}</span>
      <Icon name="fa6-solid:arrow-up-right-from-square" />
    </a>
  </Action>
</div>
