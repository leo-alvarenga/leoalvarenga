---
import { Icon } from "astro-icon/components";

import { CONTACTS } from "../../../../data";

import { getLangFromUrl, useTranslation } from "../../../../config";
import { EMAIL_FOR_CONTACT } from "../../../../utils";

const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });

const contactClasses = {
  anchor: `
    cursor-pointer flex flex-row
    gap-2 items-center justify-center
    px-4 py-1 border flex-1
    border-success group
    
    active:bg-success
    hover:bg-success

    active:text-bg3
    hover:text-bg3

    duration-250 transition-all
  `,
  preffix: `
    text-bg3
    max-w-0 overflow-hidden
    duration-250 transition-all
    group-active:max-w-12
    group-hover:max-w-12
  `,
  text: "text-center",
};
---

<div class="flex flex-col gap-4 w-full">
  <button
    class={contactClasses.anchor}
    data-email={EMAIL_FOR_CONTACT}
    data-success={t("home.titlecard.email.action.success")}
    id="email-action"
  >
    <span class={contactClasses.preffix}>
      <Icon name="fa6-solid:copy" />
    </span>

    <span id="email-action-text" class={contactClasses.text}>
      {t("home.titlecard.email.action")}
    </span>

    <Icon name="fa6-solid:envelope" />
  </button>

  <div class="flex flex-row flex-wrap items-center w-full gap-4">
    {
      CONTACTS.map(({ href, icon, label }) => (
        <a class={contactClasses.anchor} href={href} target="_blank">
          <span class={`${contactClasses.text} group-hover:underline`}>
            {t(label)}
          </span>

          <i class={icon} />
        </a>
      ))
    }
  </div>
</div>

<script lang="js">
  const emailAction = document.getElementById("email-action");
  const emailActionText = document.getElementById("email-action-text");

  if (emailAction && emailActionText) {
    emailAction.addEventListener("click", async () => {
      const email = emailAction.getAttribute("data-email");
      const successLabel = emailAction.getAttribute("data-success");
      const originalLabel = emailActionText.textContent;

      await navigator.clipboard.writeText(String(email));

      emailActionText.textContent = successLabel;
      setTimeout(() => {
        emailActionText.textContent = originalLabel;
      }, 1500);
    });
  }
</script>
