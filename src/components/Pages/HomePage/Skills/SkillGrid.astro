---
import { SKILL_GROUPS, SKILLS } from "../../../../data";
import { getLangFromUrl, useTranslation } from "../../../../config";

const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });

const groups = SKILL_GROUPS.map((category) => ({
  category,
  skills: SKILLS.filter((skill) => skill.category === category),
}));
---

<div class="flex flex-col bg-bg2 rounded-lg overflow-hidden">
  <div class="w-full bg-bg3 px-4 py-2 inline-flex items-center gap-2 justify-end">
    {["bg-error", "bg-warning", "bg-success"].map((bg) => <span class={`w-3 h-3 rounded-full ${bg}`}></span>)}
  </div>

  <div class="flex flex-col gap-8 p-6">
    <h3 class="font-code text-sm inline-flex">
      <span class="text-success">leo-alvarenga@portfolio:</span>
      <span class="text-accent font-bold">~/</span>
      <span class="text-text">$</span>
      <span class="ml-2">cat</span>
      <span class="ml-2 underline">skills.txt</span>
    </h3>

    {
      groups.map(({ category, skills }) => (
        <div class="flex flex-col gap-3">
          <h3 class="font-code text-sm text-accent1">
            {"// "}
            {t(`home.skills.category.${category}`)}
          </h3>

          <ul class="flex flex-row flex-wrap gap-2 list-none">
            {skills.map((skill) => (
              <li
                class={`
                  inline-flex items-center gap-2
                  rounded-full border px-2.5 py-1
                  font-code text-sm text-text
                  border-text/30 bg-accent1/10
                `}
              >
                {skill.isSrc ? (
                  <img
                    src={skill.icon}
                    alt=""
                    class="h-4 w-4 md:h-5 md:w-5"
                    loading="lazy"
                  />
                ) : (
                  <i class={`${skill.icon} text-base md:text-lg`} />
                )}

                <span>{skill.label}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <h3 class="font-code text-sm text-accent1">
      {`// ${t("commons.andManyMore")}...`}
    </h3>
  </div>
</div>
