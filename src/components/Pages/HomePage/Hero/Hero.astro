---
import { Icon } from "astro-icon/components";

import { getAltUrl, getLangFromUrl, useTranslation } from "../../../../config";
import HeroTitle from "./HeroTitle.astro";
import Action from "../../../Action.astro";

const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });
const blogHref = getAltUrl(Astro.url, language, "/blog");
const roles = [
  t("home.hero.role.software"),
  t("home.hero.role.devops"),
  t("home.hero.role.developer"),
  t("home.hero.role.cloud"),
];
const longestRole = roles.reduce((a, b) => (a.length >= b.length ? a : b));
---

<section class="relative w-full" id="hero">
  <div
    class="mx-auto flex w-full max-w-screen-xl flex-col items-start gap-12 px-4 py-16 lg:flex-row lg:items-center lg:gap-16 lg:px-12 lg:py-24"
  >
    <div class="flex w-full flex-col items-start gap-8 lg:w-[60%]">
      <p class="font-code text-sm text-subtext-1 lg:text-base">
        {t("home.hero.text.sm")}{" "}
        <span
          id="hero-role"
          aria-live="polite"
          class="relative inline-block font-semibold text-accent1"
        >
          <span class="invisible" aria-hidden="true">{longestRole}</span>

          {
            roles.map((role, i) => (
              <span
                aria-hidden={i === 0 ? "false" : "true"}
                class={`role-phrase absolute left-0 top-0 whitespace-nowrap transition-opacity duration-700 ${i === 0 ? "opacity-100" : "opacity-0"}`}
              >
                {role}
              </span>
            ))
          }
        </span>
      </p>

      <HeroTitle title="home.hero.text.lg" />

      <span class="mt-4 flex flex-wrap items-center gap-4">
        <Action variant="primary" className="grow-0">
          <button
            class="px-6 py-3 text-base cursor-pointer"
            onclick="scrollToContact()"
          >
            {t("home.hero.action.contact")}
          </button>
        </Action>

        <Action className="grow-0">
          <a
            class="inline-flex items-center gap-3 px-6 py-3 text-base"
            href={blogHref}
          >
            {t("home.hero.action.blog")}
            <Icon name="fa6-solid:newspaper" />
          </a>
        </Action>

        <button
          class="inline-flex cursor-pointer items-center gap-3 px-2 py-3 text-subtext-1 transition-colors duration-250 hover:text-accent1"
          onclick="scrollToXp()"
        >
          {t("home.hero.action.more")}
          <Icon class="animate-bounce" name="fa6-solid:arrow-down" />
        </button>
      </span>
    </div>

    <div class="w-full lg:w-[40%]">
      <div class="w-full overflow-hidden rounded-none border border-bg2 bg-bg3 font-code">
        <div class="flex items-center gap-2 border-b border-bg2 px-4 py-2">
          <span class="select-none text-xs text-subtext-1">~/whoami</span>
        </div>

        <div class="flex flex-col gap-2 p-6 text-sm leading-relaxed">
          <div>
            <span class="text-accent1">$</span> whoami
          </div>
          <div class="text-text">Leonardo Alvarenga</div>

          <div class="pt-2">
            <span class="text-accent1">$</span> status
          </div>
          <div class="inline-flex items-center gap-2 text-success">
            <Icon class="animate-blink text-xs" name="fa6-solid:circle" />
            <span>{t("home.contact.status")}</span>
          </div>

          <div class="pt-2">
            <span class="text-accent1">$</span> stack
          </div>
          <div class="text-subtext-1">ts · react · node · k8s · terraform</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script lang="js">
  function scrollToXp() {
    document.getElementById("xp")?.scrollIntoView();
  }

  function scrollToContact() {
    document.getElementById("contact")?.scrollIntoView();
  }
</script>

<script>
  const DURATION = 4000; // ms between phrases
  let intervalId;

  function initRole() {
    const phrases = Array.from(document.querySelectorAll("#hero-role .role-phrase"));
    if (!phrases.length) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (intervalId) clearInterval(intervalId);

    let i = 0;
    intervalId = setInterval(() => {
      const current = phrases[i];
      i = (i + 1) % phrases.length;
      const next = phrases[i];

      current.classList.remove("opacity-100");
      current.classList.add("opacity-0");
      current.setAttribute("aria-hidden", "true");

      next.classList.remove("opacity-0");
      next.classList.add("opacity-100");
      next.setAttribute("aria-hidden", "false");
    }, DURATION);
  }

  document.addEventListener("astro:page-load", initRole);
</script>
