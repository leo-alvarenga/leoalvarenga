---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getLangFromUrl, Language, useTranslation } from "../../../config";
import { blogAuthor, blogCover, formatDate, postLanguage, postSlug, readingTime } from "../../../utils";
import Section from "../../Section.astro";
import CopyButton from "../../CopyButton.astro";
import { Icon } from "astro-icon/components";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });
const { Content } = await render(post);

const backHref = language === Language.portugues ? "/pt-br/blog" : "/blog";

const slug = postSlug(post.id);
const otherLang = language === Language.portugues ? Language.english : Language.portugues;
const posts = await getCollection("blog");
const hasTranslation = posts.some(
  (p) => postSlug(p.id) === slug && postLanguage(p.id) === otherLang,
);

const author = blogAuthor(post)
const cover = blogCover(post, slug);
const time = readingTime(post.body ?? "");
const altHref = otherLang === Language.english ? `/blog/${slug}` : `/pt-br/blog/${slug}`;
const actionClass = "inline-flex items-center gap-2 rounded-lg bg-bg3 px-3 py-1.5 text-sm transition-colors hover:bg-accent1 hover:text-bg3";
---

<Section className="flex flex-col gap-8 pt-4">
  <div class="flex items-center gap-2 flex-wrap">
    <a href={backHref} class={`${actionClass} text-subtext-1 mr-auto`}>
      <Icon name="fa6-solid:arrow-left" />
      {t("blog.back")}
    </a>

    {
      hasTranslation && (
        <a href={altHref} class={`${actionClass} text-accent`}>
          <Icon name="fa6-solid:language" />
          {t("blog.readIn")}
        </a>
      )
    }

    <CopyButton
      success={t("blog.copyLink.success")}
      successClass="text-success"
      class={`${actionClass} text-subtext-1 cursor-pointer`}
    >
      <Icon name="fa6-solid:link" />
      <span data-copy-label>{t("blog.copyLink")}</span>
    </CopyButton>
  </div>

  <article class="flex flex-col gap-4 select-text">
    <div class="overflow-hidden rounded-lg">
      <img
        src={cover}
        loading="eager"
        alt={post.data.title}
        class="w-full h-64 md:h-80 object-cover"
      />
    </div>

    <header class="text-subtext-1 flex flex-col gap-2 min-w-0 border-b border-b-subtext-1/20 pb-4">
      <span class="text-sm mb-2 inline-flex gap-2 items-center">
        <div class="overflow-hidden rounded-full w-10 h-10">
          <img
            alt="Not found"
            loading="eager"
            data-isimage="true"
            src={author.picture}
          />
        </div>

        <div class="flex flex-col">
          <span class="text-text inline-flex gap-2">
            <span>
              {author.name}
            </span>

            -

            <span class="font-bold text-accent">
              {t('blog.readTime', { time })}
            </span>
          </span>

          <span class="text-xs">
            {formatDate({ start: post.data.date.toISOString() })}
          </span>
        </div>
      </span>

      <h1 class="text-3xl text-text md:text-4xl font-bold break-words">{post.data.title}</h1>
      <p class="text-lg">{post.data.description}</p>
    </header>

    <div class="blog-prose min-w-0">
      <Content />
    </div>
  </article>
</Section>

<style>
  .blog-prose {
    min-width: 0;
    user-select: text;
    overflow-wrap: break-word;
  }
  .blog-prose :global(img) {
    max-width: 100%;
    height: auto;
  }
  .blog-prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .blog-prose :global(h1),
  .blog-prose :global(h2),
  .blog-prose :global(h3) {
    font-weight: 700;
    margin: 1.75rem 0 0.75rem;
    color: var(--color-text);
  }
  .blog-prose :global(h1) {
    font-size: 1.75rem;
  }
  .blog-prose :global(h2) {
    font-size: 1.4rem;
  }
  .blog-prose :global(h3) {
    font-size: 1.15rem;
  }
  .blog-prose :global(p) {
    margin: 0.75rem 0;
    line-height: 1.7;
  }
  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .blog-prose :global(li) {
    margin: 0.25rem 0;
  }
  .blog-prose :global(a) {
    color: var(--color-accent);
  }
  .blog-prose :global(code) {
    font-family: var(--font-code);
    font-size: 0.9em;
    background: var(--color-bg3);
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
  }
  .blog-prose :global(pre) {
    background: var(--color-bg3);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow: auto;
    max-height: 24rem;
    margin: 1rem 0;
  }
  .blog-prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .blog-prose :global(strong) {
    color: var(--color-text);
  }
  .blog-prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-subtext-1);
    margin: 1rem 0;
  }
  .blog-prose :global(.code-wrapper) {
    margin: 1rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .blog-prose :global(.code-wrapper pre) {
    margin: 0;
    border-radius: 0;
  }
  .blog-prose :global(.code-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-code);
    font-size: 0.75rem;
    color: var(--color-subtext-1);
    background: var(--color-bg2);
    border-bottom: 1px solid var(--color-bg3);
  }
  .blog-prose :global(.code-copy) {
    background: transparent;
    border: 1px solid var(--color-subtext-1);
    border-radius: 0.25rem;
    padding: 0.15rem 0.5rem;
    font: inherit;
    font-size: 0.7rem;
    color: var(--color-subtext-1);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .blog-prose :global(.code-copy:hover) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

<script>
  function enhanceCodeBlocks() {
    document.querySelectorAll(".blog-prose pre").forEach((pre) => {
      if (pre.parentElement?.classList.contains("code-wrapper")) return;

      const label = document.createElement("span");
      label.textContent = pre.dataset.title || pre.dataset.language || "";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy";
      button.textContent = "Copy";
      button.dataset.copy = pre.querySelector("code")?.textContent ?? "";
      button.dataset.success = "Copied!";

      const header = document.createElement("div");
      header.className = "code-header";
      if (label.textContent) header.append(label);
      header.append(button);

      const wrapper = document.createElement("div");
      wrapper.className = "code-wrapper";
      pre.before(wrapper);
      wrapper.append(header, pre);
    });
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>
