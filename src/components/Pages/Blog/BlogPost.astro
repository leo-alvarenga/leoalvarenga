---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { getLangFromUrl, Language, useTranslation } from "../../../config";
import { blogAuthor, blogCover, formatDate, postLanguage, postSlug, readingTime } from "../../../utils";
import Section from "../../Section.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });
const { Content } = await render(post);

const backHref = language === Language.portugues ? "/pt-br/blog" : "/blog";

const slug = postSlug(post.id);
const otherLang = language === Language.portugues ? Language.english : Language.portugues;
const posts = await getCollection("blog");
const hasTranslation = posts.some(
  (p) => postSlug(p.id) === slug && postLanguage(p.id) === otherLang,
);

const author = blogAuthor(post)
const cover = blogCover(post, slug);
const time = readingTime(post.body ?? "");
const altHref = otherLang === Language.english ? `/blog/${slug}` : `/pt-br/blog/${slug}`;
---

<Section className="flex flex-col gap-8 pt-4">
  <div class="flex items-center justify-between">
    <a href={backHref} class="text-sm text-subtext-1 hover:text-accent transition-colors">
      ← {t("blog.back")}
    </a>
    {
      hasTranslation && (
        <a href={altHref} class="text-sm text-accent hover:opacity-70 transition-opacity">
          {t("blog.readIn")}
        </a>
      )
    }
  </div>

  <article class="flex flex-col gap-6 select-text">
    <div class="overflow-hidden rounded-lg">
      <img
        src={cover}
        loading="eager"
        alt={post.data.title}
        class="w-full h-64 md:h-80 object-cover"
      />
    </div>

    <header class="text-subtext-1 flex flex-col gap-2 min-w-0">
      <span class="text-sm mb-2 inline-flex gap-2 items-center">
        <div class="overflow-hidden rounded-full w-10 h-10">
          <img
            alt="Not found"
            loading="eager"
            data-isimage="true"
            src={author.picture}
          />
        </div>

        <div class="flex flex-col">
          <span class="text-text inline-flex gap-2">
            <span>
              {author.name}
            </span>

            -

            <span class="font-bold text-accent">
              {t('blog.readTime', { time })}
            </span>
          </span>

          <span class="text-xs">
            {formatDate({ start: post.data.date.toISOString() })}
          </span>
        </div>
      </span>

      <h1 class="text-3xl text-text md:text-4xl font-bold break-words">{post.data.title}</h1>
      <p class="text-lg">{post.data.description}</p>
    </header>

    <div class="blog-prose min-w-0">
      <Content />
    </div>
  </article>
</Section>

<style>
  .blog-prose {
    min-width: 0;
    user-select: text;
    overflow-wrap: break-word;
  }
  .blog-prose :global(img) {
    max-width: 100%;
    height: auto;
  }
  .blog-prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .blog-prose :global(h1),
  .blog-prose :global(h2),
  .blog-prose :global(h3) {
    font-weight: 700;
    margin: 1.75rem 0 0.75rem;
    color: var(--color-text);
  }
  .blog-prose :global(h1) {
    font-size: 1.75rem;
  }
  .blog-prose :global(h2) {
    font-size: 1.4rem;
  }
  .blog-prose :global(h3) {
    font-size: 1.15rem;
  }
  .blog-prose :global(p) {
    margin: 0.75rem 0;
    line-height: 1.7;
  }
  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .blog-prose :global(li) {
    margin: 0.25rem 0;
  }
  .blog-prose :global(a) {
    color: var(--color-accent);
  }
  .blog-prose :global(code) {
    font-family: var(--font-code);
    font-size: 0.9em;
    background: var(--color-bg3);
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
  }
  .blog-prose :global(pre) {
    background: var(--color-bg3);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow: auto;
    max-height: 24rem;
    margin: 1rem 0;
  }
  .blog-prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .blog-prose :global(strong) {
    color: var(--color-text);
  }
  .blog-prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-subtext-1);
    margin: 1rem 0;
  }
</style>
