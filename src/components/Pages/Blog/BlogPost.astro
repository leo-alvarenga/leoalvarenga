---
import { render, type CollectionEntry } from "astro:content";
import { getLangFromUrl, Language, useTranslation } from "../../../config";
import { formatDate } from "../../../utils";
import Section from "../../Section.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });
const { Content } = await render(post);

const backHref = language === Language.portugues ? "/pt-br/blog" : "/blog";
---

<Section className="flex flex-col gap-8 pt-12">
  <a href={backHref} class="text-sm text-subtext-1 hover:text-accent transition-colors">
    ← {t("blog.back")}
  </a>

  <article class="flex flex-col gap-6">
    <header class="flex flex-col gap-2">
      <span class="text-sm text-subtext-1">
        {formatDate({ start: post.data.date.toISOString() })}
      </span>
      <h1 class="text-3xl md:text-4xl font-bold">{post.data.title}</h1>
      <p class="text-subtext-1 text-lg">{post.data.description}</p>
    </header>

    <div class="blog-prose">
      <Content />
    </div>
  </article>
</Section>

<style>
  .blog-prose :global(h1),
  .blog-prose :global(h2),
  .blog-prose :global(h3) {
    font-weight: 700;
    margin: 1.75rem 0 0.75rem;
    color: var(--color-text);
  }
  .blog-prose :global(h1) {
    font-size: 1.75rem;
  }
  .blog-prose :global(h2) {
    font-size: 1.4rem;
  }
  .blog-prose :global(h3) {
    font-size: 1.15rem;
  }
  .blog-prose :global(p) {
    margin: 0.75rem 0;
    line-height: 1.7;
  }
  .blog-prose :global(ul),
  .blog-prose :global(ol) {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
  }
  .blog-prose :global(li) {
    margin: 0.25rem 0;
  }
  .blog-prose :global(a) {
    color: var(--color-accent);
  }
  .blog-prose :global(code) {
    font-family: var(--font-code);
    font-size: 0.9em;
    background: var(--color-bg3);
    padding: 0.15em 0.4em;
    border-radius: 0.375rem;
  }
  .blog-prose :global(pre) {
    background: var(--color-bg3);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .blog-prose :global(pre code) {
    background: transparent;
    padding: 0;
  }
  .blog-prose :global(strong) {
    color: var(--color-text);
  }
  .blog-prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-subtext-1);
    margin: 1rem 0;
  }
</style>
