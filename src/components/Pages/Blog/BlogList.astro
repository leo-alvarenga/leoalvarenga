---
import { getCollection } from "astro:content";
import { getLangFromUrl, Language } from "../../../config";
import { formatDate } from "../../../utils";
import Section from "../../Section.astro";
import SectionTitle from "../../SectionTitle.astro";

const [language] = getLangFromUrl(Astro.url);

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const hrefFor = (slug: string) =>
  language === Language.portugues ? `/pt-br/blog/${slug}` : `/blog/${slug}`;
---

<Section className="flex flex-col gap-8 pt-12">
  <SectionTitle title="blog.title" />

  <div class="flex flex-col gap-6 w-full px-0 md:px-8">
    {posts.map((post) => (
      <a
        href={hrefFor(post.id)}
        class={`
          flex flex-col gap-3 p-6
          rounded-lg bg-bg3 border border-bg2
          transition-colors duration-250
          hover:bg-bg2
        `}
      >
        <span class="text-sm text-subtext-1">
          {formatDate({ start: post.data.date.toISOString() })}
        </span>

        <h2 class="text-2xl font-bold text-text">{post.data.title}</h2>
        <p class="text-subtext-1">{post.data.description}</p>

        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-1 text-xs rounded-full bg-bg2 text-accent">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Section>
