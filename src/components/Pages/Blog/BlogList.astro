---
import { getCollection } from "astro:content";
import { getLangFromUrl, Language } from "../../../config";
import { blogCover, formatDate, postLanguage, postSlug } from "../../../utils";
import Section from "../../Section.astro";
import SectionTitle from "../../SectionTitle.astro";

const [language] = getLangFromUrl(Astro.url);

const posts = (await getCollection("blog"))
  .filter((post) => postLanguage(post.id) === language)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [featured, ...rest] = posts;

const hrefFor = (slug: string) =>
  language === Language.portugues ? `/pt-br/blog/${slug}` : `/blog/${slug}`;
---

<Section wide className="flex flex-col gap-8 pt-12">
  <SectionTitle title="blog.title" />

  {
    featured && (
      <a
        href={hrefFor(postSlug(featured.id))}
        class="group flex flex-col overflow-hidden rounded-lg border border-bg2 bg-bg3 hover:bg-bg2 transition-colors duration-250"
      >
        <img
          loading="eager"
          alt={featured.data.title}
          class="w-full h-64 md:h-80 object-cover"
          src={blogCover(featured, postSlug(featured.id))}
        />

        <div class="flex flex-col gap-2 p-6">
          <span class="text-sm text-subtext-1">
            {formatDate({ start: featured.data.date.toISOString() })}
          </span>
          <h2 class="text-2xl md:text-3xl font-bold text-text group-hover:text-accent transition-colors">
            {featured.data.title}
          </h2>
          <p class="text-subtext-1">{featured.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {featured.data.tags.map((tag) => (
              <span class="px-2 py-1 text-xs rounded-full bg-bg2 text-accent">{tag}</span>
            ))}
          </div>
        </div>
      </a>
    )
  }

  <div class="columns-1 md:columns-2 xl:columns-3 gap-6">
    {rest.map((post) => (
      <a
        href={hrefFor(postSlug(post.id))}
        class="mb-6 break-inside-avoid group flex flex-col overflow-hidden rounded-lg border border-bg2 bg-bg3 hover:bg-bg2 transition-colors duration-250"
      >
        <img
          src={blogCover(post, postSlug(post.id))}
          alt={post.data.title}
          loading="lazy"
          class="w-full h-auto"
        />
        <div class="flex flex-col gap-2 p-5">
          <span class="text-sm text-subtext-1">
            {formatDate({ start: post.data.date.toISOString() })}
          </span>
          <h2 class="text-xl font-bold text-text group-hover:text-accent transition-colors">
            {post.data.title}
          </h2>
          <p class="text-sm text-subtext-1">{post.data.description}</p>
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="px-2 py-1 text-xs rounded-full bg-bg2 text-accent">{tag}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </div>
</Section>
