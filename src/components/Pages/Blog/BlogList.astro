---
import { getCollection } from "astro:content";
import { getLangFromUrl, Language } from "../../../config";
import { blogCover, formatDate, postLanguage, postSlug } from "../../../utils";
import Section from "../../Section.astro";
import BlogHeader from "./BlogHeader.astro";

const [language] = getLangFromUrl(Astro.url);
const posts = (await getCollection("blog"))
  .filter((post) => postLanguage(post.id) === language)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [featured, ...rest] = posts;
const topics = new Set(posts.flatMap((p) => p.data.tags)).size;

const hrefFor = (slug: string) =>
  language === Language.portugues ? `/pt-br/blog/${slug}` : `/blog/${slug}`;
---

<Section wide className="flex flex-col gap-10 pt-8">
  <BlogHeader count={posts.length} topics={topics} />

  {
    featured && (
      <a
        href={hrefFor(postSlug(featured.id))}
        class="group flex flex-col overflow-hidden rounded-none border border-bg2 transition-colors duration-250 hover:border-accent1 md:flex-row"
      >
        <img
          loading="eager"
          alt={featured.data.title}
          src={blogCover(featured, postSlug(featured.id))}
          class="h-64 w-full object-cover md:w-1/2"
        />

        <div class="flex flex-col gap-3 p-6">
          <span class="font-code text-sm text-subtext-1">
            {formatDate({ start: featured.data.date.toISOString() })}
          </span>

          <h2 class="font-display text-2xl font-bold text-text transition-colors duration-250 group-hover:text-accent1 md:text-3xl">
            {featured.data.title}
          </h2>

          <p class="text-subtext-1">{featured.data.description}</p>

          <div class="flex flex-wrap gap-2">
            {featured.data.tags.map((tag) => (
              <span class="rounded-none border border-bg2 px-2 py-1 font-code text-xs text-subtext-1">{tag}</span>
            ))}
          </div>
        </div>
      </a>
    )
  }

  <div class="columns-1 gap-6 md:columns-2 xl:columns-3">
    {
      rest.map((post) => (
        <a
          href={hrefFor(postSlug(post.id))}
          class="mb-6 break-inside-avoid group flex flex-col overflow-hidden rounded-none border border-bg2 transition-colors duration-250 hover:border-accent1"
        >
          <img
            src={blogCover(post, postSlug(post.id))}
            alt={post.data.title}
            loading="lazy"
            class="w-full h-auto"
          />

          <div class="flex flex-col gap-2 p-5">
            <span class="font-code text-sm text-subtext-1">
              {formatDate({ start: post.data.date.toISOString() })}
            </span>

            <h2 class="font-display text-xl font-bold text-text transition-colors duration-250 group-hover:text-accent1">
              {post.data.title}
            </h2>

            <p class="text-sm text-subtext-1">{post.data.description}</p>

            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="rounded-none border border-bg2 px-2 py-1 font-code text-xs text-subtext-1">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Section>
