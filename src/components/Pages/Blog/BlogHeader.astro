---
import { getLangFromUrl, useTranslation } from "../../../config";
import Terminal from "../../Terminal.astro";

interface Props {
  count: number;
  topics: number;
}

const { count, topics } = Astro.props;
const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });
---

<Terminal title="~/blog">
  <div class="flex flex-col">
    <h1 class="flex items-center gap-2 text-3xl font-bold text-text md:text-4xl mb-8">
      {t("blog.title")}
    </h1>

    <p class="text-text">
      {t("blog.hero.tagline")}
    </p>

    <p class="text-subtext-1 inline-flex items-center">
      <span>
        {`${t("blog.hero.stats.posts", { count })} · ${t("blog.hero.stats.topics", { count: topics })}`}
      </span>
      
      <span class="ml-1 inline-block h-5 w-2 animate-blink bg-accent"></span>
    </p>
  </div>
</Terminal>
