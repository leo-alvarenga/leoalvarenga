---
import { getLangFromUrl, useTranslation } from "../../../config";

interface Props {
  count: number;
  topics: number;
}

const { count, topics } = Astro.props;
const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });
---

<div class="flex flex-col gap-4">
  <span class="font-code text-sm tracking-[0.2em] text-accent1">~/blog</span>

  <h1 class="font-display text-4xl font-bold tracking-tight text-text md:text-5xl">
    {t("blog.title")}
  </h1>

  <p class="text-lg text-subtext-1">{t("blog.hero.tagline")}</p>

  <p class="font-code text-sm text-subtext-1 inline-flex items-center">
    <span>
      {`${t("blog.hero.stats.posts", { count })} · ${t("blog.hero.stats.topics", { count: topics })}`}
    </span>

    <span class="ml-1 inline-block h-4 w-2 animate-blink bg-accent1"></span>
  </p>
</div>
