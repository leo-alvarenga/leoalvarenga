---
import { getLangFromUrl, useTranslation } from "../config";

interface Props {
  title: string;
  index?: string;
}

const [language] = getLangFromUrl(Astro.url);
const { t } = useTranslation({ language });

const { title, index } = Astro.props;
---

<div class="flex flex-col gap-3 w-full">
  {
    index && (
      <span class="font-code text-sm tracking-[0.2em] text-accent1">
        <span>
          {index}
        </span>

        <span class="text-subtext-1">_</span>
      </span>
    )
  }

  <h2 class="font-display text-3xl font-bold tracking-tight text-text md:text-4xl">
    {t(title)}
  </h2>
</div>
