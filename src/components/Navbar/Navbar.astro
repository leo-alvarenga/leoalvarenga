---
import {
  DEFAULT_LANG,
  getAltUrl,
  getLangFromUrl,
  useTranslation,
} from "../../config";
import { LANGUAGE_HINTS, LANGUAGE_LABELS, NAVBAR_LINKS } from "../../utils";
import Brand from "./Brand.astro";
import { Icon } from "astro-icon/components";

const { url } = Astro;

const [language, path] = getLangFromUrl(url);
const { t } = useTranslation({ language });

const commonClasses = "flex items-center";

const getMenuItemClass = (baseHref: string) => {
  const actualPath = (
    language === DEFAULT_LANG ? baseHref : baseHref.replace(`/${language}`, "")
  ).replace("/", "");

  const active = actualPath === path;

  let classList = `
    flex flex-row items-center
    justify-center px-2 relative
    transition-all duration-250
    group-hover:opacity-60
  `;

  if (!active) {
    return `${classList} opacity-60 hover:opacity-100`;
  }

  return `${classList} hover:opacity-100`;
};
---

<nav
  class={`w-full p-2 ${commonClasses} gap-4 justify-center relative`}
>
  <div
    class={`
    ${commonClasses}
    w-full md:w-[70vw] relative
    gap-2 p-2 text-lg z-50
    transition-all duration-250
  `}
  >
    <Brand />

    <span
      class={`
        ${commonClasses} group w-full
        justify-center md:justify-end md:ml-auto
        absolute left-0 md:static hidden
      `}
    >
      {
        NAVBAR_LINKS.map(({ label, baseHref }) => (
          <a
            class={getMenuItemClass(baseHref)}
            href={getAltUrl(url, language, baseHref)}
          >
            {t(label)}
          </a>
        ))
      }
    </span>
  </div>

  <div class="ml-auto md:ml-0 flex items-center gap-2">
    <button
      type="button"
      id="theme-toggle"
      title="Change theme"
      aria-label="Change theme"
      class="flex items-center gap-2 px-3 py-2 rounded-lg bg-bg3 text-accent hover:opacity-70 transition-all duration-250 cursor-pointer"
    >
      <Icon name="fa6-solid:palette" />
      <span id="theme-label" class="text-sm hidden sm:inline">Catppuccin Mocha</span>
    </button>

    <div class="relative">
      <button
        type="button"
        id="lang-toggle"
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-controls="lang-dropdown"
        title={LANGUAGE_HINTS[language]}
        class="flex items-center gap-2 px-3 py-2 rounded-lg bg-bg3 text-accent hover:opacity-70 transition-all duration-250 cursor-pointer"
      >
        <Icon name="fa6-solid:globe" />
        <span class="text-sm hidden sm:inline">{LANGUAGE_LABELS[language]}</span>
        <span class="text-sm sm:hidden">{language === DEFAULT_LANG ? "EN" : "PT"}</span>
        <Icon name="fa6-solid:chevron-down" />
      </button>

      <ul
        id="lang-dropdown"
        role="listbox"
        class="absolute right-0 mt-2 min-w-[10rem] hidden flex-col gap-1 p-2 rounded-lg bg-bg3 border border-bg2 shadow-lg z-50"
      >
        {
          Object.entries(LANGUAGE_LABELS).map(([lang, label]) => (
            <li role="option" aria-selected={lang === language}>
              <button
                type="button"
                data-lang={lang}
                class={`w-full text-left px-2 py-1 rounded-md hover:opacity-70  cursor-pointer ${lang === language ? "underline" : ""}`}
              >
                {label}
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<script is:inline src="/scripts/i18n.js"></script>

<script>
  const THEMES = [
    { id: "catppuccin", label: "Catppuccin Mocha" },
    { id: "kanagawa", label: "Kanagawa Wave" },
    { id: "latte", label: "Catppuccin Latte" },
  ];

  function currentTheme() {
    const saved = localStorage.getItem("theme");

    return saved && THEMES.some((t) => t.id === saved) ? saved : THEMES[0].id;
  }

  function applyTheme(id) {
    THEMES.forEach((t) =>
      document.body.classList.toggle("theme-" + t.id, t.id === id)
    );

    localStorage.setItem("theme", id);
    const themeLabel = document.getElementById("theme-label");

    if (themeLabel) themeLabel.textContent = THEMES.find((t) => t.id === id).label;
  }

  // ---- Language dropdown ----
  function setLangOpen(open) {
    const langBtn = document.getElementById("lang-toggle");
    const dropdown = document.getElementById("lang-dropdown");

    dropdown?.classList.toggle("hidden", !open);
    langBtn?.setAttribute("aria-expanded", String(open));
  }

  function closeLang() {
    setLangOpen(false);
  }

  function init() {
    applyTheme(currentTheme()); // re-apply on view-transition navigation

    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const cur = currentTheme();
      const i = THEMES.findIndex((t) => t.id === cur);

      applyTheme(THEMES[(i + 1) % THEMES.length].id);
    });

    const langBtn = document.getElementById("lang-toggle");
    const dropdown = document.getElementById("lang-dropdown");

    langBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      setLangOpen(langBtn.getAttribute("aria-expanded") !== "true");
    });

    dropdown?.querySelectorAll("[data-lang]").forEach((opt) => {
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        const lang = opt.dataset.lang;

        closeLang();
        document.dispatchEvent(new CustomEvent("lang_change", { detail: lang }));
      });
    });
  }

  document.addEventListener("click", closeLang);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLang();
  });

  document.addEventListener("astro:page-load", init);
</script>
