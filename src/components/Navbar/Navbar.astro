---
import {
  DEFAULT_LANG,
  getAltUrl,
  getLangFromUrl,
  useTranslation,
} from "../../config";
import { LANGUAGE_HINTS, LANGUAGE_LABELS, NAVBAR_LINKS } from "../../utils";
import Brand from "./Brand.astro";
import { Icon } from "astro-icon/components";

const { url } = Astro;
const [language, path] = getLangFromUrl(url);
const { t } = useTranslation({ language });

const getMenuItemClass = (baseHref: string) => {
  const actualPath = (
    language === DEFAULT_LANG ? baseHref : baseHref.replace(`/${language}`, "")
  ).replace("/", "");

  const active = actualPath === path;

  return "transition-colors duration-250 " + (active
    ? "text-accent1 hover:text-text underline"
    : "text-text hover:text-accent1")
};
---

<nav class="w-full border-b border-bg2 p-2 relative">
  <div class="mx-auto flex w-full max-w-screen-xl items-center gap-4 px-2">
    <Brand />

    <span class="ml-auto flex items-center gap-5">
      {
        NAVBAR_LINKS.map(({ label, baseHref }) => (
          <a
            class={`font-display text-sm ${getMenuItemClass(baseHref)}`}
            href={getAltUrl(url, language, baseHref)}
          >
            {t(label)}
          </a>
        ))
      }
    </span>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="theme-toggle"
        title="Change theme"
        aria-label="Change theme"
        class="flex items-center gap-2 rounded-none border border-bg2 px-3 py-2 text-subtext-1 transition-colors duration-250 cursor-pointer hover:border-accent1 hover:text-accent1"
      >
        <Icon name="fa6-solid:palette" />
        <span id="theme-label" class="text-sm hidden sm:inline">Catppuccin Mocha</span>
      </button>

      <div class="relative">
        <button
          type="button"
          id="lang-toggle"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="lang-dropdown"
          title={LANGUAGE_HINTS[language]}
          class="flex items-center gap-2 rounded-none border border-bg2 px-3 py-2 text-subtext-1 transition-colors duration-250 cursor-pointer hover:border-accent1 hover:text-accent1"
        >
          <Icon name="fa6-solid:globe" />
          <span class="text-sm hidden sm:inline">{LANGUAGE_LABELS[language]}</span>
          <span class="text-sm sm:hidden">{language === DEFAULT_LANG ? "EN" : "PT"}</span>
          <Icon name="fa6-solid:chevron-down" />
        </button>

        <ul
          id="lang-dropdown"
          role="listbox"
          class="absolute right-0 mt-2 min-w-[10rem] hidden flex-col gap-1 rounded-none border border-bg2 bg-bg1 p-2 shadow-xl z-50"
        >
          {
            Object.entries(LANGUAGE_LABELS).map(([lang, label]) => (
              <li role="option" aria-selected={lang === language}>
                <button
                  type="button"
                  data-lang={lang}
                  class={`w-full text-left px-2 py-1 cursor-pointer transition-colors duration-250 ${lang === language ? "text-accent1" : "text-subtext-1 hover:text-text"}`}
                >
                  {label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</nav>

<script is:inline src="/scripts/i18n.js"></script>

<script>
  const THEMES = [
    { id: "catppuccin", label: "Catppuccin Mocha" },
    { id: "kanagawa", label: "Kanagawa Wave" },
    { id: "latte", label: "Catppuccin Latte" },
  ];

  function currentTheme() {
    const saved = localStorage.getItem("theme");

    return saved && THEMES.some((t) => t.id === saved) ? saved : THEMES[0].id;
  }

  function applyTheme(id) {
    THEMES.forEach((t) =>
      document.documentElement.classList.toggle("theme-" + t.id, t.id === id)
    );

    localStorage.setItem("theme", id);
    const themeLabel = document.getElementById("theme-label");

    if (themeLabel) themeLabel.textContent = THEMES.find((t) => t.id === id).label;
  }

  // ---- Language dropdown ----
  function setLangOpen(open) {
    const langBtn = document.getElementById("lang-toggle");
    const dropdown = document.getElementById("lang-dropdown");

    dropdown?.classList.toggle("hidden", !open);
    langBtn?.setAttribute("aria-expanded", String(open));
  }

  function closeLang() {
    setLangOpen(false);
  }

  function init() {
    applyTheme(currentTheme()); // re-apply on view-transition navigation

    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      const cur = currentTheme();
      const i = THEMES.findIndex((t) => t.id === cur);

      applyTheme(THEMES[(i + 1) % THEMES.length].id);
    });

    const langBtn = document.getElementById("lang-toggle");
    const dropdown = document.getElementById("lang-dropdown");

    langBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      setLangOpen(langBtn.getAttribute("aria-expanded") !== "true");
    });

    dropdown?.querySelectorAll("[data-lang]").forEach((opt) => {
      opt.addEventListener("click", (e) => {
        e.stopPropagation();
        const lang = opt.dataset.lang;

        closeLang();
        document.dispatchEvent(new CustomEvent("lang_change", { detail: lang }));
      });
    });
  }

  document.addEventListener("click", closeLang);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLang();
  });

  document.addEventListener("astro:page-load", init);
</script>
