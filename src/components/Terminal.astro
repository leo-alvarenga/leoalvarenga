---
interface Props {
  className?: string;
  title?: string;
}

const { className = "", title } = Astro.props;
---

<div
  class={`w-full overflow-hidden rounded-lg bg-bg3 font-code shadow-lg shadow-bg3 ${className}`}
>
  <div class="flex items-center gap-2 bg-bg2 px-4 py-2 border-t border-t-accent">
    {
      title && (
        <span class="ml-2 select-none text-xs text-subtext-1">{title}</span>
      )
    }
  </div>

  <div class="p-6">
    <slot />
  </div>
</div>
