---
interface Props {
  text?: string;
  class?: string;
  title?: string;
  success?: string;
  successClass?: string;
}

const { text, success = "Copied!", successClass, class: className, title } = Astro.props;
---

<button
  type="button"
  title={title}
  class={className}
  data-copy={text ?? ""}
  data-success={success}
  data-success-class={successClass}
>
  <slot />
</button>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const btn = target.closest("[data-copy]");
    if (!btn) return;

    const text = btn.getAttribute("data-copy") || location.href;
    const label = btn.querySelector("[data-copy-label]") ?? btn;

    const original = label.textContent ?? "";
    const successClass = btn.getAttribute("data-success-class");
    const success = btn.getAttribute("data-success") ?? "Copied!";

    try {
      await navigator.clipboard.writeText(text);
      label.textContent = success;

      if (successClass) btn.classList.add(successClass);
    } catch {
      label.textContent = "Failed";
    }

    setTimeout(() => {
      label.textContent = original;

      if (successClass) btn.classList.remove(successClass);
    }, 2000);
  });
</script>
