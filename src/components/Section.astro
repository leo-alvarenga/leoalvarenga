---
import { slide } from "astro:transitions";

interface Props {
  className?: string;
  id?: string;
  wide?: boolean;
}

const { className, id, wide } = Astro.props;
const widthClass = wide ? "w-full md:w-[95%] lg:w-[85%]" : "w-full md:w-[90%] lg:w-[72%]";
---

<section
  class={`${widthClass} ${className}`}
  id={id}
  transition:animate={slide({ duration: "0.4s" })}
>
  <slot />
</section>
