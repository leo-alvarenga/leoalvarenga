---
interface Props {
  className?: string;
  variant?: "primary" | "ghost";
}

const { className = "", variant = "ghost" } = Astro.props;

const base =
  "grow flex gap-4 items-center duration-250 transition-all cursor-pointer group justify-center text-center overflow-hidden whitespace-nowrap rounded-none";

const variants = {
  primary: "border border-accent1 bg-accent1 text-bg1 hover:opacity-80",
  ghost: "border border-bg2 text-subtext-1 hover:border-accent1 hover:text-accent1",
};
---

<span class={`${base} ${variants[variant]} ${className}`}>
  <slot />
</span>
