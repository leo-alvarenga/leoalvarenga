---
import { getAltUrl, getLangFromUrl, useTranslation } from "../config";
import {
  getDefaultOpenGraph,
  HOST_NAME,
  PAGE_TITLE_PREFFIX,
  type OpenGraphOptions,
} from "../utils";

interface Props {
  options: OpenGraphOptions;
}

const { url } = Astro;
const [language] = getLangFromUrl(url);
const { t } = useTranslation({ language });

const defaultOG = getDefaultOpenGraph(language);

const { options } = Astro.props;
const {
  author = "",
  title = "",
  description = "",
  image = {
    default: defaultOG.image?.default,
    square: defaultOG.image?.square,
  },
  pathname = "/",
} = { ...defaultOG, ...options };

const ogUrl = HOST_NAME.concat(getAltUrl(url, language, pathname));

const locale = language === "pt-br" ? "pt_BR" : "en_US";
const altLocale = locale === "pt_BR" ? "en_US" : "pt_BR";

const absolute = (src: string) =>
  src.startsWith("http") ? src : HOST_NAME.concat(src);
---

<meta property="og:title" content={t(title)} />
<meta property="og:author" content={t(author)} />
<meta property="og:description" content={t(description)} />
<meta property="og:type" content="website" />
<meta property="og:url" content={ogUrl} />
<meta property="og:site_name" content={PAGE_TITLE_PREFFIX} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={altLocale} />

<meta name="description" content={t(description)} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={t(title)} />
<meta name="twitter:description" content={t(description)} />

<link rel="canonical" href={ogUrl} />

{
  image?.default && (
    <Fragment>
      <meta property="og:image" content={absolute(image.default.src)} />
      <meta property="og:image:alt" content={image.default.alt} />
      <meta property="og:image:width" content={String(image.default.width ?? 1200)} />
      <meta property="og:image:height" content={String(image.default.height ?? 627)} />
      <meta name="twitter:image" content={absolute(image.default.src)} />
      <meta name="twitter:image:alt" content={image.default.alt} />
    </Fragment>
  )
}

{
  image?.square && (
    <Fragment>
      <meta property="og:image" content={absolute(image.square.src)} />
      <meta property="og:image:alt" content={image.square.alt} />
      <meta property="og:image:width" content={String(image.square.width ?? 400)} />
      <meta property="og:image:height" content={String(image.square.height ?? 400)} />
    </Fragment>
  )
}
