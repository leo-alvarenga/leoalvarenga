---
import Navbar from "../components/Navbar/Navbar.astro";
import Layout from "./Layout.astro";
import { pageTitleToId, type OpenGraphOptions } from "../utils";
import Footer from "../components/Footer.astro";

interface Props {
  className?: string;
  disableFooter?: boolean;
  disableNavbar?: boolean;
  openGraph?: OpenGraphOptions;
  pageTitle?: string;
  preventRefBehavior?: boolean;
}

const {
  className = "",
  disableFooter,
  disableNavbar,
  openGraph,
  pageTitle,
  preventRefBehavior,
} = Astro.props;

const pageId = pageTitleToId(pageTitle, "content");
---

<Layout openGraph={openGraph} pageTitle={pageTitle}>
  {!disableNavbar && <Navbar />}

  <main
    class={`
        flex flex-col gap-4 mx-auto
        ${disableNavbar ? "" : "mt-4 md:mt-8"}
        w-full p-4 pb-10 scroll-smooth
        relative items-center
        font-quicksand ${className}
    `}
    data-pageid={pageId}
    id="page-content"
  >
    <slot />
  </main>


  {!disableFooter && <Footer />}
  {!preventRefBehavior && <script is:inline>setCurrentRef();</script>}
</Layout>
